<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android and Windows only — no iOS or Mac -->
        <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>TheBonding.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name shown on device -->
        <ApplicationTitle>The Bonding</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.thebonding.app</ApplicationId>

        <!-- Versions
             Android versionName: 1.YYYY.MM.DD  (increment ApplicationVersion integer on every Play Store upload)
             Windows MSIX:        1.YYYY.MMDD.0  (Store requires last component = 0; MMDD encodes month+day) -->
        <ApplicationDisplayVersion Condition="$(TargetFramework.Contains('android'))">1.2026.05.17</ApplicationDisplayVersion>
        <ApplicationDisplayVersion Condition="$(TargetFramework.Contains('windows'))">1.2026.517.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Windows: run unpackaged (no Store requirement)
             REMOVE this line when submitting to the Microsoft Store (switches to MSIX packaging) -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Android Release: always produce an App Bundle (required by Play Store) -->
    <PropertyGroup Condition="$(TargetFramework.Contains('android')) and '$(Configuration)' == 'Release'">
        <AndroidPackageFormat>aab</AndroidPackageFormat>
    </PropertyGroup>

    <!-- Windows: include tile/splash PNGs in the MSIX package -->
    <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
        <Content Include="Platforms\Windows\Assets\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1b1b2f" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1b1b2f" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TheBonding.Application\TheBonding.Application.csproj" />
        <ProjectReference Include="..\TheBonding.Infrastructure\TheBonding.Infrastructure.csproj" />
        <ProjectReference Include="..\TheBonding.Shared\TheBonding.Shared.csproj" />
    </ItemGroup>

</Project>
