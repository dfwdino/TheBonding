@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@implements IDisposable
@using Microsoft.Maui.ApplicationModel

<div class="app-shell" @ontouchstart="OnTouchStart" @ontouchend="OnTouchEnd">
    <header class="app-header">
        <button class="btn-hamburger" @onclick="ToggleNav" title="Menu">&#9776;</button>
        <span class="app-name">The Bonding v@(AppInfo.Current.VersionString)</span>
        <button class="btn-lock" title="Lock app" @onclick="LockApp">&#128274;</button>
    </header>

    @if (_navOpen)
    {
        <div class="nav-backdrop" @onclick="CloseNav"></div>
    }

    <div class="app-body">
        <nav class="app-nav @(_navOpen ? "nav-open" : "nav-closed")">
            <NavMenu />
        </nav>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool   _navOpen    = false;
    private double _touchStartX;
    private double _touchStartY;

    protected override void OnInitialized()
    {
        // Close the nav whenever the route changes (user tapped a menu item)
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_navOpen)
        {
            _navOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNav()  => _navOpen = false;

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        _touchStartX = e.Touches[0].ClientX;
        _touchStartY = e.Touches[0].ClientY;
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        var deltaX = e.ChangedTouches[0].ClientX - _touchStartX;
        var deltaY = e.ChangedTouches[0].ClientY - _touchStartY;

        // Ignore if vertical scroll dominates or swipe too short
        if (Math.Abs(deltaY) > Math.Abs(deltaX)) return;
        if (Math.Abs(deltaX) < 60) return;

        if (deltaX > 0 && _touchStartX < 60 && !_navOpen)
            _navOpen = true;   // swipe right from left edge → open
        else if (deltaX < 0 && _navOpen)
            _navOpen = false;  // swipe left → close
    }

    private void LockApp()
    {
        AuthService.Lock();
        Nav.NavigateTo("/unlock", replace: true);
    }
}
