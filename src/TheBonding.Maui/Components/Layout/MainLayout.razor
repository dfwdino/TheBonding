@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@implements IDisposable
@using Microsoft.Maui.ApplicationModel

<div class="app-shell">
    <header class="app-header">
        <button class="btn-hamburger" @onclick="ToggleNav" title="Menu">&#9776;</button>
        <span class="app-name">The Bonding v@(AppInfo.Current.VersionString)</span>
        <button class="btn-lock" title="Lock app" @onclick="LockApp">&#128274;</button>
    </header>

    @if (_navOpen)
    {
        <div class="nav-backdrop" @onclick="CloseNav"></div>
    }

    <div class="app-body">
        <nav class="app-nav @(_navOpen ? "nav-open" : "nav-closed")">
            <NavMenu />
        </nav>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navOpen = false;

    protected override void OnInitialized()
    {
        // Close the nav whenever the route changes (user tapped a menu item)
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_navOpen)
        {
            _navOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNav()  => _navOpen = false;

    private void LockApp()
    {
        AuthService.Lock();
        Nav.NavigateTo("/unlock", replace: true);
    }
}
