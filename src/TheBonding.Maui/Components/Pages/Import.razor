@page "/import"
@using System.Text.Json
@using Microsoft.Maui.Storage
@inject IAuthService AuthService
@inject IActivityService ActivityService
@inject IPartnerService PartnerService
@inject IPartnerHealthStatusService HealthService
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="page-title">Import Data</h1>
</div>

<p class="text-muted">
    Select a previously exported JSON file to restore your data.
    Partners and events will be added to the current database.
</p>

<div class="export-warning">
    <strong>⚠ Warning:</strong> This will <em>add</em> to your existing data, not replace it.
    Importing the same file twice will create duplicate records.
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-message" style="margin-top:1rem">@_error</div>
}

@if (_result is not null)
{
    <div class="success-message" style="margin-top:1rem">
        ✓ Import complete — @_result.Partners partner(s), @_result.Events event(s),
        @_result.HealthRecords health record(s) imported.
        @if (_result.Errors > 0)
        {
            <span> @_result.Errors record(s) could not be imported.</span>
        }
    </div>
}

<div style="margin-top:1.5rem">
    <label class="form-label">Select export file (.json)</label>
    <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; margin-top:0.4rem">
        <button class="btn-secondary" @onclick="PickFileAsync" disabled="@_busy">Choose File</button>
        <span class="text-muted" style="font-size:0.9rem">
            @(_pickedFileName is not null ? _pickedFileName : "No file selected")
        </span>
    </div>
</div>

<div class="form-actions" style="margin-top:1rem">
    <button class="btn-primary" @onclick="ImportAsync" disabled="@(_busy || _pickedContent is null)">
        @(_busy ? "Importing…" : "Import")
    </button>
</div>

@code {
    private bool _busy;
    private string _error = string.Empty;
    private string? _pickedFileName;
    private string? _pickedContent;
    private ImportResult? _result;

    private static readonly PickOptions PickerOptions = new()
    {
        PickerTitle = "Select a Bonding export file",
        FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            { DevicePlatform.Android, new[] { "application/json", "text/plain", "*/*" } },
            { DevicePlatform.WinUI,   new[] { ".json" } }
        })
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsUnlocked)
            Nav.NavigateTo("/unlock", replace: true);
    }

    private async Task PickFileAsync()
    {
        _error  = string.Empty;
        _result = null;

        var picked = await FilePicker.Default.PickAsync(PickerOptions);
        if (picked is null) return;

        await using var stream = await picked.OpenReadAsync();
        using var reader = new StreamReader(stream);
        _pickedContent  = await reader.ReadToEndAsync();
        _pickedFileName = picked.FileName;
        StateHasChanged();
    }

    private async Task ImportAsync()
    {
        if (_pickedContent is null) return;

        _busy  = true;
        _error = string.Empty;
        _result = null;

        try
        {
            var json = _pickedContent;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var export  = JsonSerializer.Deserialize<ExportDto>(json, options);

            if (export is null)
            {
                _error = "Could not parse the file. Make sure it is a valid Bonding export.";
                return;
            }

            var counts       = new ImportResult();
            var partnerIdMap = new Dictionary<int, int>(); // oldId → newId

            foreach (var p in export.Partners ?? [])
            {
                if (p.Record is null) continue;

                var pr = await PartnerService.CreateAsync(p.Record);
                if (!pr.IsSuccess) { counts.Errors++; continue; }

                partnerIdMap[p.Id] = pr.Value;
                counts.Partners++;

                foreach (var hr in p.HealthRecords ?? [])
                {
                    if (hr.Data is null) continue;
                    var hrr = await HealthService.CreateAsync(pr.Value, hr.Data);
                    if (hrr.IsSuccess) counts.HealthRecords++;
                    else counts.Errors++;
                }
            }

            foreach (var ev in export.Events ?? [])
            {
                if (ev.Record is null) continue;

                ev.Record.PartnerIds = ev.Record.PartnerIds
                    .Select(old => partnerIdMap.TryGetValue(old, out var n) ? n : old)
                    .ToList();

                var er = await ActivityService.CreateAsync(ev.Record);
                if (er.IsSuccess) counts.Events++;
                else counts.Errors++;
            }

            _result = counts;
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ImportResult
    {
        public int Partners      { get; set; }
        public int Events        { get; set; }
        public int HealthRecords { get; set; }
        public int Errors        { get; set; }
    }

    private sealed class ExportDto
    {
        public List<EventExportDto>?   Events   { get; set; }
        public List<PartnerExportDto>? Partners { get; set; }
    }

    private sealed class EventExportDto
    {
        public int           Id     { get; set; }
        public ActivityRecord? Record { get; set; }
    }

    private sealed class PartnerExportDto
    {
        public int           Id            { get; set; }
        public bool          IsActive      { get; set; }
        public PartnerRecord? Record        { get; set; }
        public List<PartnerHealthStatusSummary>? HealthRecords { get; set; }
    }
}
