@page "/unlock"
@layout AuthLayout
@inject IAuthService AuthService
@inject IDataManagementService DataManagement
@inject NavigationManager Nav

@if (_loading)
{
    <div class="unlock-spinner-wrap">
        <div class="unlock-spinner"></div>
        <p class="unlock-status">Decrypting your data&hellip;</p>
        <p class="unlock-status-sub">This takes a moment to keep your data safe.</p>
    </div>
}
else
{
<div class="auth-card">
    <h2>Welcome Back</h2>

    @if (_lockedOut)
    {
        <div class="error-message" style="margin-bottom:0.75rem">
            <strong>App locked.</strong><br />
            Too many failed attempts. Try again at
            <strong>@_lockoutUntil?.ToLocalTime().ToString("h:mm tt")</strong>.
        </div>
        <button class="btn-secondary" style="width:100%;margin-top:0.5rem" @onclick="CheckLockout">
            Check Again
        </button>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-message" style="margin-bottom:0.75rem">@_error</div>
        }

        <div class="form-group">
            <label class="form-label" for="pwd">Password</label>
            <div style="display:flex;gap:0.4rem">
                <input id="pwd"
                       type="@(_showPassword ? "text" : "password")"
                       class="form-control"
                       placeholder="Enter your password"
                       @bind="_password"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       autofocus />
                <button type="button" class="btn-secondary"
                        style="white-space:nowrap;padding:0.45rem 0.75rem"
                        @onclick="ToggleShow">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
        </div>

        <button class="btn-primary" style="width:100%;margin-top:1.25rem"
                @onclick="UnlockAsync"
                disabled="@string.IsNullOrWhiteSpace(_password)">
            Unlock
        </button>

        <div style="text-align:center;margin-top:1.25rem">
            <button type="button" class="btn-link-inline" @onclick="() => _confirmForgot = true">
                Forgot your password?
            </button>
        </div>
    }
</div>
}

@* ── Step 1: Explain what "forgot password" actually means ── *@
@if (_confirmForgot)
{
    <div class="confirm-overlay">
        <div class="confirm-box" style="border-top:4px solid #c0392b">
            <p style="font-size:1.5rem;text-align:center;margin:0 0 0.5rem">⚠️</p>
            <p class="confirm-message" style="text-align:center">
                <strong>There is no password recovery.</strong>
            </p>
            <p class="text-muted" style="font-size:0.9rem;margin:0.5rem 0 1rem">
                Your data is encrypted with a key that only your password can unlock.
                If you've forgotten your password, the <strong>only option is to wipe
                the entire app</strong> — all events, partners, health records, and
                your account will be <strong>permanently deleted</strong> with no way
                to get them back.
            </p>
            <div class="confirm-actions">
                <button class="btn-danger" @onclick="ShowFinalConfirm" disabled="@_resetting">
                    I understand — show me the delete option
                </button>
                <button class="btn-secondary" @onclick="() => _confirmForgot = false" disabled="@_resetting">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@* ── Step 2: Final "no going back" confirmation ── *@
@if (_confirmForgotFinal)
{
    <div class="confirm-overlay">
        <div class="confirm-box" style="border-top:4px solid #c0392b">
            <p style="font-size:1.5rem;text-align:center;margin:0 0 0.5rem">🗑️</p>
            <p class="confirm-message" style="text-align:center;color:#c0392b">
                <strong>This is your last chance to cancel.</strong>
            </p>
            <p class="text-muted" style="font-size:0.9rem;margin:0.5rem 0 1rem;text-align:center">
                Tapping the button below will <strong>permanently erase everything</strong>
                in this app. This action <strong>cannot be undone</strong>.
            </p>
            <div class="confirm-actions">
                <button class="btn-danger" @onclick="DoFullResetAsync" disabled="@_resetting">
                    @(_resetting ? "Deleting…" : "Yes, delete everything and start over")
                </button>
                <button class="btn-secondary" @onclick="CancelForgot" disabled="@_resetting">
                    Cancel — take me back
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string    _password          = string.Empty;
    private string    _error             = string.Empty;
    private bool      _loading           = false;
    private bool      _showPassword      = false;
    private bool      _lockedOut         = false;
    private DateTime? _lockoutUntil      = null;
    private bool      _confirmForgot     = false;
    private bool      _confirmForgotFinal = false;
    private bool      _resetting         = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsUnlocked)
        {
            Nav.NavigateTo("/dashboard", replace: true);
            return;
        }
        if (!AuthService.IsSetup)
        {
            Nav.NavigateTo("/setup", replace: true);
            return;
        }
        await CheckLockout();
    }

    private async Task CheckLockout()
    {
        _lockoutUntil = await AuthService.GetLockoutUntilAsync();
        _lockedOut    = _lockoutUntil.HasValue && _lockoutUntil.Value > DateTime.UtcNow;
        StateHasChanged();
    }

    private void ToggleShow() => _showPassword = !_showPassword;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnlockAsync();
    }

    private void ShowFinalConfirm()
    {
        _confirmForgot      = false;
        _confirmForgotFinal = true;
    }

    private void CancelForgot()
    {
        _confirmForgot      = false;
        _confirmForgotFinal = false;
    }

    private async Task DoFullResetAsync()
    {
        _resetting = true;
        try
        {
            await DataManagement.FullResetAsync();
            AuthService.Lock();
            await AuthService.LoadAsync();
            Nav.NavigateTo("/", replace: true);
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task UnlockAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_password)) return;

        _loading = true;
        StateHasChanged();           // show spinner immediately
        await Task.Delay(30);        // let the UI repaint before the CPU-heavy PBKDF2 runs

        try
        {
            var result = await AuthService.UnlockAsync(_password);

            if (result.IsFailure)
            {
                _error    = result.Error!;
                _password = string.Empty;
                await CheckLockout();
                return;
            }

            Nav.NavigateTo("/dashboard", replace: true);
        }
        finally
        {
            _loading = false;
        }
    }
}
