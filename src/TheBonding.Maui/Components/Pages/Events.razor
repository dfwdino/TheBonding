@page "/events"
@inject IAuthService AuthService
@inject IActivityService ActivityService
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="page-title">Events</h1>
    <a href="/events/new" class="btn-add">+ Add</a>
</div>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_events.Count == 0)
{
    <p class="empty-state">No events logged yet. Tap <strong>+ Add</strong> to create your first.</p>
}
else
{
    <div class="filter-row">
        <input type="text" class="filter-input" placeholder="Search…" @bind="_search" @bind:event="oninput" />
    </div>

    <div class="list-card">
        @foreach (var ev in Filtered)
        {
            var evId = ev.Id;
            <div class="list-item" @onclick="@(() => EditEvent(evId))">
                <div class="list-item-main">
                    <span class="list-item-title">@(string.IsNullOrWhiteSpace(ev.Data.Title) ? "Untitled" : ev.Data.Title)</span>
                    <span class="list-item-sub">@ev.OccurredDate.ToString("MMM d, yyyy")</span>
                </div>
                <span class="list-item-arrow">›</span>
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private List<ActivitySummary> _events = [];
    private string _search = string.Empty;

    private IEnumerable<ActivitySummary> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _events
            : _events.Where(e => (e.Data.Title ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        if (!AuthService.IsUnlocked)
            Nav.NavigateTo("/unlock", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await ActivityService.GetAllAsync();
        if (result.IsSuccess)
            _events = result.Value!.OrderByDescending(e => e.OccurredDate).ToList();

        _loading = false;
        StateHasChanged();
    }

    private void EditEvent(int id) => Nav.NavigateTo($"/events/{id}/edit");
}
